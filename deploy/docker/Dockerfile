# Container image for asiair-commander. Build from the repo root:
#
#   docker build -f deploy/docker/Dockerfile .
#
# Three stages: SPA build, Go cross-compile, distroless runtime. The first two
# are pinned to $BUILDPLATFORM so a multi-arch build (linux/amd64 + linux/arm64)
# compiles natively and only the COPY-only runtime stage varies per target —
# no QEMU emulation needed.

FROM --platform=$BUILDPLATFORM node:26-alpine AS spa
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Bake the build version into the SPA (Vite's __APP_VERSION__) from the SAME
# VERSION build-arg the Go stage feeds -ldflags, so the embedded UI and the
# binary report one string and the out-of-sync banner only fires on a real skew.
# Unset (a plain `docker build` with no --build-arg) falls back to "dev".
ARG VERSION=dev
RUN ASIAIR_COMMANDER_VERSION=$VERSION npm run build

FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src
# Resolve dependencies from the Go proxy first, so this layer caches across
# source-only changes.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Stage the SPA into the go:embed source dir, exactly as `make spa` does.
RUN rm -rf internal/web/dist
COPY --from=spa /web/dist/ internal/web/dist/
ARG TARGETOS TARGETARCH
ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags "-X main.version=$VERSION -X main.commit=$COMMIT -X main.buildTime=$BUILD_TIME" \
    -o /out/asiair-commander ./cmd/asiair-commander
# Licence and third-party notices for exactly this target, generated by the
# Makefile's notices target (the same one the Windows installer uses) from the
# SPA's notices staged above and the Go modules linked for TARGETOS/TARGETARCH.
RUN apk add --no-cache make && \
    make notices VERSION="$VERSION" NOTICES=/out/THIRD_PARTY_NOTICES \
      NOTICES_GOOS="$TARGETOS" NOTICES_GOARCH="$TARGETARCH"
# Seed directory for /data so an anonymous volume is writable by nonroot.
RUN mkdir -p /out/data
# Fetch + verify the per-arch ASTAP plate-solver CLI (Tier-1) pinned in
# deploy/astap/astap-cli.json and stage it beside the binary. BUNDLE_ASTAP=0 skips
# it (offline/local builds); plate solving then falls back to PATH or stays paused.
# The github_token secret is only needed for the mirror fallback, which the fetch
# reaches when upstream has rolled past the pin; a build without it succeeds for as
# long as SourceForge still serves the pinned bytes. An absent secret leaves the mount
# point empty rather than failing, so `docker build .` stays usable by hand.
ARG BUNDLE_ASTAP=1
RUN --mount=type=secret,id=github_token \
    mkdir -p /out/astap && \
    if [ "$BUNDLE_ASTAP" = "1" ]; then \
      GH_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
        go run ./tools/fetch-astap fetch linux/${TARGETARCH} /out/astap; \
    fi

# distroless/static: our binary is CGO_ENABLED=0 and the pinned Linux astap_cli is
# statically linked (verified: no ld-linux interpreter), so neither needs a libc.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/asiair-commander /asiair-commander
# Bundle the plate solver beside the binary (the provisioner resolves it there first).
# /out/astap is empty when built with BUNDLE_ASTAP=0 — the COPY is then a no-op.
COPY --from=build /out/astap/ /
COPY --from=build --chown=nonroot:nonroot /out/data /data
COPY --from=build /out/THIRD_PARTY_NOTICES/ /usr/share/doc/asiair-commander/
EXPOSE 8686 8687
VOLUME /data
# Declare this process containerized, so the first-run log line and the setup
# wizard's help panel name a channel the operator actually has (`docker logs`)
# instead of a host log path that does not exist for them. The runtime also
# probes /.dockerenv and /proc/1/cgroup, but those miss or misreport some
# runtimes; a marker baked into the image is the reliable signal.
ENV ASIAIR_COMMANDER_CONTAINER=1
# The healthcheck verb itself polls /healthz for up to 30s (it reads the port
# from /data/config.yaml, and always probes plain HTTP), hence the 35s timeout.
HEALTHCHECK --interval=30s --timeout=35s --start-period=10s \
  CMD ["/asiair-commander", "healthcheck", "-data-dir", "/data"]
ENTRYPOINT ["/asiair-commander"]
CMD ["run", "-data-dir", "/data"]
