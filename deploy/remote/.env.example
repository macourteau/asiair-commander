# Copy to .env next to docker-compose.yml, then run `chmod 600 .env`.
#
# These variable names are a forward-compatible contract with the compose file.

# The pairing Commander shows once when you add or re-pair a remote. Paste the
# whole value, which starts with "acremote:". It holds the remote's private key
# and the pinned Commander key, so keep this file private and do not share it.
# The remote refuses to start without it.
ASIAIR_REMOTE_PAIRING=

# The image tag to run. "latest" follows each release; to roll back, set a
# release version (of the form X.Y.Z), then run `docker compose up -d`.
REMOTE_TAG=latest

# The time zone for the update schedule and the logs (an IANA name such as
# America/Toronto). Updates run daily at 14:00 in this zone.
TZ=UTC
